POST /api/github/publish
import { NextResponse } from "next/server";

export async function POST(req: Request) {
  try {
    const { repo, owner, branch, files, message } = await req.json();

    if (!process.env.GITHUB_TOKEN) {
      return NextResponse.json(
        { error: "Missing GITHUB_TOKEN" },
        { status: 500 }
      );
    }

    const token = process.env.GITHUB_TOKEN;

    // 1) Create branch reference
    const baseRef = await fetch(
      `https://api.github.com/repos/${owner}/${repo}/git/refs/heads/main`,
      {
        headers: { Authorization: `Bearer ${token}` },
      }
    ).then((r) => r.json());

    const newBranchRef = await fetch(
      `https://api.github.com/repos/${owner}/${repo}/git/refs`,
      {
        method: "POST",
        headers: {
          Authorization: `Bearer ${token}`,
          "Content-Type": "application/json",
        },
        body: JSON.stringify({
          ref: `refs/heads/${branch}`,
          sha: baseRef.object.sha,
        }),
      }
    ).then((r) => r.json());

    // 2) Create blobs for each file
    const blobs = await Promise.all(
      files.map(async (file) => {
        const blob = await fetch(
          `https://api.github.com/repos/${owner}/${repo}/git/blobs`,
          {
            method: "POST",
            headers: {
              Authorization: `Bearer ${token}`,
              "Content-Type": "application/json",
            },
            body: JSON.stringify({
              content: file.content,
              encoding: "utf-8",
            }),
          }
        ).then((r) => r.json());

        return {
          path: file.path,
          mode: "100644",
          type: "blob",
          sha: blob.sha,
        };
      })
    );

    // 3) Create a tree
    const tree = await fetch(
      `https://api.github.com/repos/${owner}/${repo}/git/trees`,
      {
        method: "POST",
        headers: {
          Authorization: `Bearer ${token}`,
          "Content-Type": "application/json",
        },
        body: JSON.stringify({
          base_tree: baseRef.object.sha,
          tree: blobs,
        }),
      }
    ).then((r) => r.json());

    // 4) Create commit
    const commit = await fetch(
      `https://api.github.com/repos/${owner}/${repo}/git/commits`,
      {
        method: "POST",
        headers: {
          Authorization: `Bearer ${token}`,
          "Content-Type": "application/json",
        },
        body: JSON.stringify({
          message,
          tree: tree.sha,
          parents: [baseRef.object.sha],
        }),
      }
    ).then((r) => r.json());

    // 5) Update branch to point to commit
    await fetch(
      `https://api.github.com/repos/${owner}/${repo}/git/refs/heads/${branch}`,
      {
        method: "PATCH",
        headers: {
          Authorization: `Bearer ${token}`,
          "Content-Type": "application/json",
        },
        body: JSON.stringify({
          sha: commit.sha,
        }),
      }
    );

    // 6) Create pull request
    const pr = await fetch(
      `https://api.github.com/repos/${owner}/${repo}/pulls`,
      {
        method: "POST",
        headers: {
          Authorization: `Bearer ${token}`,
          "Content-Type": "application/json",
        },
        body: JSON.stringify({
          title: message,
          head: branch,
          base: "main",
        }),
      }
    ).then((r) => r.json());

    return NextResponse.json({
      status: "success",
      branch,
      commit: commit.sha,
      pull_request: pr.html_url,
    });
  } catch (err) {
    return NextResponse.json(
      { error: err.message || "Unknown error" },
      { status: 500 }
    );
  }
}
